# ------------------------------------------------------------
# Core runtime
# ------------------------------------------------------------

NODE_ENV=development
PORT=5000
SHUTDOWN_TIMEOUT_MS=10000
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------
# Supabase
# Optional during P2.3, but all three values must be supplied
# together once Supabase integration is enabled.
# SUPABASE_SERVICE_ROLE_KEY is server-only.
# ------------------------------------------------------------

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# AI providers
# API keys are server-only.
# Provider-specific requirements will be enforced by the AI
# integration phase.
# ------------------------------------------------------------

AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------
# Resume storage
# ------------------------------------------------------------

RESUME_BUCKET=resumes

# ------------------------------------------------------------
# Authentication cookies
# COOKIE_SECURE must be true in production.
# COOKIE_SAME_SITE=none requires COOKIE_SECURE=true.
# ------------------------------------------------------------

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------

LOG_LEVEL=info

# ------------------------------------------------------------
# Core runtime
# ------------------------------------------------------------

NODE_ENV=development
PORT=5000
SHUTDOWN_TIMEOUT_MS=10000
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------
# Supabase
#
# Use the preferred SUPABASE_SECRET_KEY for new projects.
# SUPABASE_SERVICE_ROLE_KEY is temporary legacy compatibility.
#
# Supply:
#   SUPABASE_URL
#   SUPABASE_PUBLISHABLE_KEY
#   exactly one privileged key
#
# Never expose either privileged key to frontend code.
# ------------------------------------------------------------

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy only; leave blank when SUPABASE_SECRET_KEY is used.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# AI providers
# API keys are server-only.
# Provider-specific requirements will be enforced by the AI
# integration phase.
# ------------------------------------------------------------

AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------
# Resume storage
# ------------------------------------------------------------

RESUME_BUCKET=resumes

# ------------------------------------------------------------
# Authentication cookies
# COOKIE_SECURE must be true in production.
# COOKIE_SAME_SITE=none requires COOKIE_SECURE=true.
# ------------------------------------------------------------

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ------------------------------------------------------------
# Logging & Observability
# ------------------------------------------------------------

LOG_LEVEL=info
# Set LOG_PRETTY to true in development for human-readable logs
# LOG_PRETTY=true

LOG_HEALTH_REQUESTS=false

LOG_CLIENT_IP_MODE=omit
# Required only when LOG_CLIENT_IP_MODE=hash
LOG_CLIENT_IP_HASH_KEY=

APP_VERSION=0.1.0
GIT_COMMIT_SHA=unknown

SHUTDOWN_GRACE_PERIOD_MS=15000

# ------------------------------------------------------------
# Express and proxy security
#
# Set TRUST_PROXY_HOPS only when the deployment proxy topology
# is known. Zero means forwarded headers are not trusted.
# ------------------------------------------------------------

TRUST_PROXY_HOPS=0

# ------------------------------------------------------------
# General API rate limiting
#
# The in-memory limiter is suitable for local development and
# a single backend process. A shared store is required for
# horizontally scaled production deployments.
# ------------------------------------------------------------

RATE_LIMIT_ENABLED=true
RATE_LIMIT_IPV6_SUBNET=56
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------
# Browser CORS preflight
# ------------------------------------------------------------

CORS_PREFLIGHT_MAX_AGE_SECONDS=600

# ------------------------------------------------------------
# Authentication session lifecycle
#
# Refresh tokens are stored in an HttpOnly cookie.
# Access tokens are returned in successful JSON responses.
# ------------------------------------------------------------

AUTH_REFRESH_COOKIE_MAX_AGE_SECONDS=31536000

# ------------------------------------------------------------
# Authentication endpoint rate limiting
# Applies to registration, login and session refresh.
# ------------------------------------------------------------

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_SESSION_RATE_LIMIT_WINDOW_MS=60000
AUTH_SESSION_RATE_LIMIT_MAX_REQUESTS=30

# ------------------------------------------------------------
# API Request Boundaries
# ------------------------------------------------------------

API_JSON_BODY_LIMIT_BYTES=65536
API_MAX_URL_LENGTH=4096
API_MAX_QUERY_PARAMETERS=50

# ------------------------------------------------------------
# HTTP Server Timeouts and Limits
# ------------------------------------------------------------

SERVER_REQUEST_TIMEOUT_MS=30000
SERVER_HEADERS_TIMEOUT_MS=10000
SERVER_KEEP_ALIVE_TIMEOUT_MS=5000
SERVER_MAX_HEADERS_COUNT=100

# Environment configuration template
# Server-only variables like API keys must not be committed to version control.

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Supabase Configuration
# Note: SUPABASE_SERVICE_ROLE_KEY is server-only. Do not leak to frontend.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Provider Configuration
# Note: These keys are server-only.
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Storage Configuration
RESUME_BUCKET=resumes

# Security Configuration
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Logging
LOG_LEVEL=info
